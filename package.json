{
	"name": "announcing",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter @announcing/web dev",
		"dev:backend": "pnpm --filter @announcing/backend dev",
		"db:migrate": "pnpm --filter @announcing/web db:migrate",
		"build": "pnpm -r build",
		"gen": "pnpm -r gen",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"test:e2e": "pnpm --filter @announcing/web test:e2e"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.1.0",
		"eslint": "^10.6.0",
		"eslint-plugin-svelte": "^3.20.0",
		"svelte": "^5.56.4",
		"svelte-eslint-parser": "^1.8.0",
		"typescript": "^6.0.3"
	}
}
